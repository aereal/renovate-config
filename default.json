{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    ":masterIssue",
    ":prConcurrentLimit10",
    ":separateMultipleMajorReleases",
    ":timezone(Asia/Tokyo)"
  ],
  "ignorePresets": [
    ":prConcurrentLimit20"
  ],
  "labels": [
    "renovate"
  ],
  "postUpdateOptions": [
    "yarnDedupeHighest",
    "gomodTidy"
  ],
  "npm": {
    "rangeStrategy": "bump"
  },
  "pin": {
    "automerge": true
  },
  "patch": {
    "automerge": true
  },
  "packageRules": [
    {
      "matchDatasources": ["npm"],
      "labels": ["kind:npm"]
    },
    {
      "matchDatasources": ["go"],
      "labels": ["kind:go"]
    },
    {
      "matchPackageNames": [
        "@types/**"
      ],
      "automerge": true,
      "major": {
        "automerge": false
      }
    },
    {
      "groupName": "ESLint",
      "packageNames": [
        "prettier"
      ],
      "matchPackageNames": [
        "prettier",
        "/^@?eslint/",
        "@typescript-eslint/**"
      ]
    },
    {
      "groupName": "testing-library",
      "matchPackageNames": [
        "@testing-library/**"
      ],
      "automerge": true,
      "major": {
        "automerge": false
      }
    },
    {
      "groupName": "aws-cdk",
      "matchPackageNames": [
        "aws-cdk",
        "@aws-cdk/**"
      ],
      "automerge": true,
      "major": {
        "automerge": false
      }
    },
    {
      "groupName": "aws-sdk",
      "matchPackageNames": [
        "/^github.com/aws/aws-sdk-go-v2/"
      ]
    }
  ]
}
